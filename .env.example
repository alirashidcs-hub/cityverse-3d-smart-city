# Copy this file to .env (for `vercel dev`) or configure the same keys in
# your Vercel project settings (Project → Settings → Environment Variables).
# Never commit a real .env file with actual secrets.

# ---------------------------------------------------------------------------
# AI Assistant (required for the AI City Assistant panel to work)
# ---------------------------------------------------------------------------
# Server-side only — used by /api/assistant.ts. Never exposed to the browser.
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

# ---------------------------------------------------------------------------
# Supabase (not yet wired up in this prototype — see docs/deployment.md and
# docs/database-schema.md for the planned integration). Safe to leave blank
# until you're ready to move off the in-browser demo data.
# ---------------------------------------------------------------------------
# Public — safe to expose to the browser (protected by Row-Level Security)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-only — never prefix with VITE_ (that would expose it to the client)
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Optional: rate limiting for the AI assistant / API routes (see
# docs/security.md). Not required to run the app locally.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ---------------------------------------------------------------------------
# Optional: IoT ingestion gateway (see docs/iot-integration.md). Only
# relevant once you're connecting real sensors instead of demo data.
# ---------------------------------------------------------------------------
MQTT_BROKER_URL=
